# Orchestrator configuration

# Port the HTTP server listens on
PORT=5000

# Groq API key (https://console.groq.com) — the LLM behind the agent loop
GROQ_API_KEY=

# MCP server URLs — point these at the 4 campus MCP servers
EVENTS_MCP_URL=http://localhost:5003/mcp
CAFETERIA_MCP_URL=http://localhost:5004/mcp
LIBRARY_MCP_URL=http://localhost:5005/mcp
ACADEMICS_MCP_URL=http://localhost:5006/mcp

# Comma-separated list of allowed browser origins for CORS.
# Leave unset in local dev to fall back to localhost defaults.
# In production, set to your deployed frontend origin(s).
CORS_ORIGINS=

# Per-session conversation TTL in ms (default 30 min).
SESSION_TTL_MS=1800000

# Max number of concurrent sessions kept in memory (LRU eviction).
MAX_SESSIONS=1000
